# Anansi platform API (the same surface the web console uses).
# Client calls {ANANSI_API_BASE_URL}/api
ANANSI_API_BASE_URL=http://localhost:5001

# Default dataset id, sent as the X-Database header (wed | gmd).
ANANSI_DATASET=wed

# HTTP timeout in seconds.
ANANSI_TIMEOUT=30

# Response shaping.
ANANSI_PAGE_SIZE=100
ANANSI_MAX_OBSERVATIONS=2000

# Firebase web config (public — same as the website and Excel add-in).
# The MCP's OAuth login uses these to sign the user in and mint ID tokens.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=

# Public base URL of this MCP server (used for OAuth redirects and discovery).
# IMPORTANT: must exactly match the URL the MCP client connects to. Codex uses
# 127.0.0.1 loopback callbacks, so keep 127.0.0.1 here — not localhost.
ANANSI_MCP_BASE_URL=http://127.0.0.1:8000
# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
MCP_SESSION_SECRET=
